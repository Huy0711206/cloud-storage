FROM node:24-alpine AS frontend
WORKDIR /ui
RUN corepack enable && corepack prepare pnpm@11.25.0 --activate
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
RUN pnpm exec tsc -b && pnpm exec vite build --config vite.mail.config.ts

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY legacy/gateways/mail_gateway.py ./legacy/gateways/mail_gateway.py
COPY --from=frontend /ui/dist-mail ./frontend/dist-mail
EXPOSE 8000
CMD ["uvicorn", "legacy.gateways.mail_gateway:app", "--host", "0.0.0.0", "--port", "8000"]
