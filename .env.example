# Sao chép file này thành ".env" rồi sửa các giá trị. KHÔNG đưa file .env lên GitHub.

# --- Cơ sở dữ liệu ---
POSTGRES_USER=cloud
POSTGRES_PASSWORD=doi_mat_khau_db_nay

# --- Nextcloud (tài khoản quản trị dùng để portal gọi API) ---
NEXTCLOUD_ADMIN_USER=ncadmin
NEXTCLOUD_ADMIN_PASSWORD=Doi-Mat-Khau-Nextcloud-1
# Địa chỉ người dùng mở Nextcloud trên trình duyệt
NEXTCLOUD_PUBLIC_URL=http://localhost:8080
# Thêm tên miền/IP khác nếu truy cập từ máy khác (cách nhau bằng dấu cách), ví dụ: 192.168.1.10
EXTRA_TRUSTED_DOMAINS=

# --- Portal ---
SECRET_KEY=doi-chuoi-ngau-nhien-dai-nay-32-ky-tu-tro-len
BASE_URL=http://localhost:8000
# Tài khoản admin của portal (tự tạo khi khởi động lần đầu)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin-Portal-12345

# --- Email ---
# Chạy thử: dùng Mailpit có sẵn (xem thư tại http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=CloudBox <no-reply@cloudbox.local>
# Gửi email thật bằng Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_STARTTLS=true,
# SMTP_USER=<gmail của bạn>, SMTP_PASSWORD=<Mật khẩu ứng dụng 16 ký tự>

# --- Thanh toán VNPay ---
# Sandbox: đăng ký tại https://sandbox.vnpayment.vn/devreg để nhận TmnCode và HashSecret
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Chạy thật (sau khi ký hợp đồng với VNPay): https://pay.vnpayment.vn/vpcpay.html
