# Copy only for a NEW installation. Never overwrite an existing .env.
POSTGRES_USER=cloud
POSTGRES_PASSWORD=replace-with-a-private-database-password
SECRET_KEY=replace-with-at-least-32-random-private-characters
BASE_URL=https://cloudbox.rachiba.top
ADMIN_EMAIL=your-admin@gmail.com
ADMIN_PASSWORD=replace-with-a-private-admin-password

# Real Gmail SMTP. Enable Google 2-Step Verification and create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=replace-with-google-app-password
MAIL_FROM=your-sender@gmail.com

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Source Nextcloud settings are needed ONLY while using the legacy profile/migrator.
NEXTCLOUD_ADMIN_USER=ncadmin
NEXTCLOUD_ADMIN_PASSWORD=
EXTRA_TRUSTED_DOMAINS=
